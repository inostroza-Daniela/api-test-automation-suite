{
  "name": "api-test-automation-suite",
  "version": "1.0.0",
  "description": "Suite de pruebas automatizadas de API REST con Playwright Test y TypeScript",
  "type": "module",
  "private": true,
  "author": "Daniela Inostroza Mancilla",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/inostroza-Daniela/api-test-automation-suite.git"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:critical": "playwright test --grep @critical",
    "test:local": "TEST_ENV=local playwright test",
    "report": "playwright show-report",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm run format:check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "eslint-plugin-playwright": "^2.12.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "zod": "^4.6.7"
  }
}
